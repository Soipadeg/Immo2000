# Configuration pour Immo2000 Backend

## Variables d'environnement

# API Melo
MELO_API_KEY=your_melo_api_key_here
MELO_API_BASE_URL=https://api.melo.io/v1/estimations
MELO_API_TIMEOUT=10
MELO_API_MAX_RETRIES=3
MELO_API_CACHE_ENABLED=true
MELO_API_CACHE_TTL=3600

# Base de données (à configurer)
DATABASE_URL=postgresql://user:password@localhost:5432/immo2000
DATABASE_ECHO=false

# Flask/API
FLASK_ENV=development
FLASK_DEBUG=true
API_PORT=5000
API_HOST=0.0.0.0

# JWT Authentication
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
JWT_ACCESS_TOKEN_EXPIRES_IN=86400  # 24 heures en secondes
JWT_REFRESH_TOKEN_EXPIRES_IN=604800  # 7 jours en secondes

# Logging
LOG_LEVEL=INFO

# Configuration SMTP pour l'envoi d'emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=noreply@immo2000.fr
EMAIL_PASSWORD=ton_mot_de_passe_app_ou_mot_de_passe_smtp

# URL du frontend (pour les liens dans les emails)
FRONTEND_URL=http://localhost:3000
