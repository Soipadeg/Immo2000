# .env Configuration Template for Google OAuth

# =====================================================
# GOOGLE OAUTH CONFIGURATION
# =====================================================

# Google OAuth Client ID
# Get from: https://console.cloud.google.com/
# OAuth 2.0 Client ID for Web Application
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com

# Google OAuth Client Secret
# Keep this SECRET - never commit to version control!
GOOGLE_CLIENT_SECRET=your_client_secret_here_KEEP_SECRET

# OAuth Redirect URI
# Must match exactly in Google Cloud Console
# Development
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# Production (uncomment for production)
# GOOGLE_REDIRECT_URI=https://yourdomain.com/api/v1/auth/google/callback


# =====================================================
# SESSION CONFIGURATION (for OAuth)
# =====================================================

# Session lifetime in seconds (default: 3600 = 1 hour)
SESSION_TIMEOUT=3600

# Secure cookies (set to True in production)
SESSION_COOKIE_SECURE=False  # Set to True with HTTPS

# HTTP Only cookies (prevent JS access)
SESSION_COOKIE_HTTPONLY=True

# SameSite cookie policy
SESSION_COOKIE_SAMESITE=Lax  # Use 'Strict' for maximum security


# =====================================================
# DATABASE CONFIGURATION (for OAuth users)
# =====================================================

# Database URL - for storing OAuth users
DATABASE_URL=sqlite:///immo2000.db

# For PostgreSQL (production recommended)
# DATABASE_URL=postgresql://user:password@localhost:5432/immo2000


# =====================================================
# SECURITY CONFIGURATION
# =====================================================

# Secret key for Flask session encryption
SECRET_KEY=your_secret_key_here_change_in_production

# CSRF Protection
WTF_CSRF_ENABLED=True

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5000"]


# =====================================================
# LOGGING CONFIGURATION
# =====================================================

# Log level for OAuth operations
LOG_LEVEL=INFO

# OAuth error logging
OAUTH_ERROR_LOGGING=True


# =====================================================
# DEPLOYMENT ENVIRONMENT
# =====================================================

# Environment: development, staging, production
FLASK_ENV=development

# Debug mode (set to False in production!)
FLASK_DEBUG=True

# Host and port
FLASK_HOST=localhost
FLASK_PORT=5000
