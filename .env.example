# ================================================
# IMMO2000 - Environment Configuration Template
# Copy this to .env and fill in production values
# ================================================

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# Security (GENERATE NEW SECRETS)
# Run: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-generated-secret-key-here
JWT_SECRET_KEY=your-generated-jwt-secret-here

# CORS Configuration (Production) - RESTRICT TO YOUR DOMAINS
CORS_ALLOWED_ORIGINS=https://immo2000.com,https://www.immo2000.com,http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/immo2000_db
DATABASE_ECHO=False

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# ================================================
# External Services (Required for Production)
# ================================================

## DocuSign (Signature électronique des contrats)
DOCUSIGN_CLIENT_ID=your-docusign-client-id
DOCUSIGN_PRIVATE_KEY=your-docusign-private-key
DOCUSIGN_USER_ID=your-docusign-user-id

## Stripe (Paiements en ligne)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

## SendGrid (Envoi d'emails)
SENDGRID_API_KEY=your-sendgrid-api-key

## AWS S3 (Stockage des documents)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=immo2000-documents
AWS_S3_REGION=eu-west-1

# ================================================
# Optional Services
# ================================================

## Melo API (Estimations immobilières)
MELO_API_KEY=your-melo-api-key
MELO_API_CACHE_TTL=3600

## FCM (Notifications push mobiles)
FCM_API_KEY=your-fcm-api-key

## Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

## Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

## Apple OAuth
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id

# ================================================
# Monitoring & Logging
# ================================================

## Sentry (Error tracking)
SENTRY_DSN=your-sentry-dsn

## Prometheus (Metrics)
PROMETHEUS_ENABLED=True

## Logging
LOG_LEVEL=INFO

# ================================================
# JWT Configuration
# ================================================

JWT_ACCESS_TOKEN_EXPIRES_IN=86400  # 24 hours
JWT_REFRESH_TOKEN_EXPIRES_IN=604800  # 7 days
