# Phase 7: Environment Configuration (.env.phase7)

# ========== SENTRY CONFIGURATION ==========
SENTRY_DSN=https://your-key@sentry.io/your-project-id
SENTRY_TRACES_RATE=0.1  # 10% of requests sampled
SENTRY_PROFILES_RATE=0.1

# ========== FIREBASE CONFIGURATION ==========
FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# ========== MIXPANEL CONFIGURATION ==========
REACT_APP_MIXPANEL_TOKEN=your-mixpanel-token
MIXPANEL_BATCH_SIZE=50

# ========== JAEGER TRACING ==========
JAEGER_HOST=localhost
JAEGER_PORT=6831
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1

# ========== ELASTICSEARCH (ELK Stack) ==========
ELASTICSEARCH_HOST=elasticsearch:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=your-password
ELASTICSEARCH_INDEX_PREFIX=immo2000

# ========== LOGSTASH ==========
LOGSTASH_HOST=logstash:5000

# ========== KIBANA ==========
KIBANA_URL=http://kibana:5601

# ========== PAGERDUTY ==========
PAGERDUTY_KEY=your-pagerduty-integration-key
PAGERDUTY_API_TOKEN=your-pagerduty-api-token

# ========== SLACK ==========
SLACK_TOKEN=xoxb-your-slack-token
SLACK_ALERTS_CHANNEL=#alerts
SLACK_INCIDENTS_CHANNEL=#incidents
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ========== PROMETHEUS ==========
PROMETHEUS_PORT=9090

# ========== GRAFANA ==========
GRAFANA_URL=http://grafana:3000
GRAFANA_API_KEY=your-grafana-api-key

# ========== LOGGING ==========
LOG_DIR=/app/logs
LOG_LEVEL=INFO
LOG_FORMAT=json

# ========== MONITORING ==========
METRICS_ENABLED=true
TRACING_ENABLED=true
PROFILING_ENABLED=true
REPLAY_ENABLED=true

# ========== ALERT THRESHOLDS ==========
ERROR_RATE_THRESHOLD=5.0  # percent
RESPONSE_TIME_THRESHOLD=1000  # milliseconds
DB_QUERY_TIME_THRESHOLD=100  # milliseconds
MEMORY_THRESHOLD=85  # percent
CPU_THRESHOLD=80  # percent
DISK_THRESHOLD=90  # percent

# ========== FEATURE FLAGS ==========
ENABLE_ERROR_TRACKING=true
ENABLE_ANALYTICS=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_DISTRIBUTED_TRACING=true
ENABLE_ALERTING=true
ENABLE_CUSTOM_DASHBOARDS=true

# ========== RETENTION POLICIES ==========
LOGS_RETENTION_DAYS=30
METRICS_RETENTION_DAYS=90
TRACES_RETENTION_DAYS=7
PROFILES_RETENTION_DAYS=7

# ========== DATA SAMPLING ==========
TRACE_SAMPLE_RATE=0.1
REPLAY_SAMPLE_RATE_ON_ERROR=1.0
PROFILE_SAMPLE_RATE=0.1
METRIC_SAMPLE_RATE=1.0
