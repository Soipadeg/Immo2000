# =============================================================================
# Priority 3 Implementation - Environment Variables & Dependencies
# =============================================================================

# Backend Optimization - Cache & Celery
# redis://[user]:[password]@[host]:[port]/[db]
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Elasticsearch for Advanced Search
ELASTICSEARCH_URL=http://localhost:9200

# Firebase Cloud Messaging (FCM) for Push Notifications
FIREBASE_PROJECT_ID=your-project-id
FCM_API_KEY=your-fcm-api-key

# Loan Simulator APIs
# Choose either Pretto or Melo
PRETTO_API_KEY=your-pretto-api-key
# OR
MELO_API_KEY=your-melo-api-key

# External APIs
# Virtual Tours
MATTERPORT_API_KEY=your-matterport-api-key

# Document Signing
DOCUSIGN_INTEGRATION_KEY=your-docusign-key
DOCUSIGN_SECRET=your-docusign-secret
DOCUSIGN_ACCOUNT_ID=your-docusign-account

# Error Tracking & Monitoring
SENTRY_DSN=your-sentry-dsn

# =============================================================================
# Docker Services Configuration
# =============================================================================

# PostgreSQL
POSTGRES_USER=immo2000
POSTGRES_PASSWORD=secure_password_change_me
POSTGRES_DB=immo2000_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Elasticsearch
ES_HOST=elasticsearch
ES_PORT=9200

# =============================================================================
# Application Settings for Priority 3
# =============================================================================

# Cache TTL (in seconds)
CACHE_TIMEOUT_SHORT=300      # 5 minutes for frequently updated data
CACHE_TIMEOUT_LONG=3600      # 1 hour for stable data

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# WebSocket
SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379/0

# Celery Workers
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH=4
