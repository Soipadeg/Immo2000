# FastAPI Configuration
FASTAPI_ENV=production
DEBUG=false
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgresql+asyncpg://immo2000:secure_password_123@postgres:5432/immo2000
DB_POOL_SIZE=20
DB_POOL_RECYCLE=3600

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# JWT Configuration
SECRET_KEY=super_secret_key_change_in_production_12345678
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000,http://127.0.0.1:3000

# API Configuration
API_TITLE=Immo2000 API
API_VERSION=6.0.0
API_DESCRIPTION=Production API

# Email Configuration (optional for demo)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM_ADDRESS=noreply@immo2000.fr

# Sentry Configuration (optional)
SENTRY_DSN=

# Feature Flags
ENABLE_CACHE=true
ENABLE_MONITORING=true
ENABLE_AUDIT_LOGGING=true

# Admin Settings
ADMIN_EMAIL=admin@immo2000.fr
ADMIN_PASSWORD=AdminPassword123!
