# Backend Configuration for Docker

# Database
DB_NAME=immo2000
DB_USER=immo2000
DB_PASSWORD=immo2000_secure_password_change_me
DB_PORT=5432
DATABASE_URL=postgresql://immo2000:immo2000_secure_password_change_me@postgres:5432/immo2000

# Flask
FLASK_ENV=production
FLASK_APP=src.app
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# API Configuration
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://immo2000.vercel.app

# Email/SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@immo2000.com
SMTP_FROM_NAME=Immo2000

# Logging
LOG_LEVEL=INFO

# API Port
API_PORT=5000
