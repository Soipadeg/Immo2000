# =====================================================
# IMMO2000 PRODUCTION ENVIRONMENT
# =====================================================
# IMPORTANT: Never commit secrets to git!
# Use this as a template and replace all CHANGE_ME values

# =====================================================
# 1. APPLICATION CONFIGURATION
# =====================================================
ENVIRONMENT=production
FLASK_ENV=production
FASTAPI_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# =====================================================
# 2. DATABASE CONFIGURATION
# =====================================================
DB_NAME=immo2000
DB_USER=immo2000
# Generate with: openssl rand -hex 16 | tr -d '\n'
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION_32_CHAR_MIN

# Connection Pool
DB_POOL_SIZE=20
DB_POOL_RECYCLE=3600

# =====================================================
# 3. SECURITY & JWT
# =====================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_32_CHAR_MIN
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_32_CHAR_MIN
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# Enable 2FA and HTTPS enforcement
ENABLE_2FA=true
ENABLE_HTTPS=true
ENABLE_AUDIT_LOGGING=true
ENABLE_MONITORING=true

# =====================================================
# 4. CORS & DOMAIN CONFIGURATION
# =====================================================
# Change to your actual production domain(s)
CORS_ALLOWED_ORIGINS=https://immo2000.fr,https://www.immo2000.fr
DOMAIN=immo2000.fr

# =====================================================
# 5. REDIS CACHE CONFIGURATION
# =====================================================
REDIS_URL=redis://:CHANGE_ME_PASSWORD@redis:6379/0
# Generate password with: openssl rand -hex 24
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION_32_CHAR_MIN

# =====================================================
# 6. EMAIL/SMTP CONFIGURATION
# =====================================================
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM_ADDRESS=noreply@immo2000.fr
EMAIL_SMTP_USER=your-email@gmail.com
# Use app-specific password for Gmail
EMAIL_SMTP_PASSWORD=CHANGE_ME_IN_PRODUCTION

# =====================================================
# 7. API INTEGRATIONS
# =====================================================

# Stripe Payment Processing
STRIPE_SECRET_KEY=sk_live_CHANGE_ME_IN_PRODUCTION
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME_IN_PRODUCTION
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME_IN_PRODUCTION

# Melo (Real Estate Estimation API)
MELO_API_KEY=CHANGE_ME_IN_PRODUCTION
MELO_API_BASE_URL=https://api.melo.io/v1/estimations
MELO_API_TIMEOUT=10
MELO_API_MAX_RETRIES=3
MELO_API_CACHE_ENABLED=true
MELO_API_CACHE_TTL=3600

# Document Verification (Choose one)
YOUSIGN_API_KEY=CHANGE_ME_IN_PRODUCTION
YOUSIGN_API_URL=https://api.yousign.com
VERIFF_API_KEY=CHANGE_ME_IN_PRODUCTION

# DocuSign eSignature
DOCUSIGN_INTEGRATION_KEY=CHANGE_ME_IN_PRODUCTION
DOCUSIGN_SECRET=CHANGE_ME_IN_PRODUCTION
DOCUSIGN_USER_ID=CHANGE_ME_IN_PRODUCTION

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=CHANGE_ME_IN_PRODUCTION.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME_IN_PRODUCTION

# =====================================================
# 8. MONITORING & ERROR TRACKING
# =====================================================
SENTRY_DSN=https://CHANGE_ME_IN_PRODUCTION@sentry.io/PROJECT_ID
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# =====================================================
# 9. AWS S3 CONFIGURATION (For backups)
# =====================================================
AWS_ACCESS_KEY_ID=CHANGE_ME_IN_PRODUCTION
AWS_SECRET_ACCESS_KEY=CHANGE_ME_IN_PRODUCTION
AWS_REGION=eu-west-1
S3_BUCKET=immo2000-backups
S3_PATH=backups/postgresql

# =====================================================
# 10. ADMIN CREDENTIALS
# =====================================================
ADMIN_EMAIL=admin@immo2000.fr
# Use bcrypt hash in production, NOT plain text
ADMIN_PASSWORD=USE_BCRYPT_HASH_IN_PRODUCTION

# =====================================================
# 11. FEATURE FLAGS
# =====================================================
ENABLE_CACHE=true
ENABLE_MONITORING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_2FA=true
ENABLE_HTTPS=true

# =====================================================
# 12. BACKUP CONFIGURATION
# =====================================================
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=./backups
