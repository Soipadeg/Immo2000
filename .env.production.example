# ====================
# PRODUCTION ENVIRONMENT
# ====================

# Application
ENVIRONMENT=production
FLASK_ENV=production
DEBUG=False
PORT=8000

# Database (Railway générera DATABASE_URL automatiquement)
# DATABASE_URL=postgresql://user:password@host:port/db
SQLALCHEMY_TRACK_MODIFICATIONS=False

# JWT & Security
JWT_SECRET=your-super-secret-key-generate-random
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS - Frontend URL
CORS_ORIGINS=https://immo2000.vercel.app,https://ton-domaine.com

# Email/SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@immo2000.fr

# External Services
YOUSIGN_API_KEY=your-yousign-key
YOUSIGN_API_URL=https://api.yousign.com
VERIFF_API_KEY=your-veriff-key
DOCUSIGN_INTEGRATION_KEY=your-docusign-key
STRIPE_SECRET_KEY=sk_live_your_stripe_key

# Monitoring
LOG_LEVEL=INFO
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Redis (optionnel)
REDIS_URL=redis://localhost:6379

# Feature Flags
ENABLE_2FA=true
ENABLE_AUDIT_LOGGING=true
ENABLE_MONITORING=true
